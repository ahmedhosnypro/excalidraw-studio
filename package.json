{
  "name": "excalidraw-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "typecheck": "tsgo --noEmit",
    "db:push": "drizzle-kit push --hints '[{\"type\":\"create\",\"kind\":\"table\",\"entity\":[\"public\",\"comments\"]},{\"type\":\"create\",\"kind\":\"table\",\"entity\":[\"public\",\"files\"]},{\"type\":\"create\",\"kind\":\"table\",\"entity\":[\"public\",\"sessions\"]},{\"type\":\"create\",\"kind\":\"table\",\"entity\":[\"public\",\"users\"]}]'",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "quality": "bun run typecheck && oxlint . --deny-warnings && biome check . && eslint . && jscpd src && KNIP_DISABLE_RAW_TRANSFER=1 knip"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@apollo/server": "^5.5.1",
    "@as-integrations/next": "^4.1.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-graphql": "^0.8.5",
    "drizzle-orm": "1.0.0-rc.4",
    "graphql": "16.11.0",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bun-types": "^1.3.4",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-drizzle": "0.2.3",
    "jscpd": "^5.1.0",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "description": "Self-hosted Excalidraw rebuild with accounts, server file storage, comments, command palette and presentations",
  "patchedDependencies": {
    "drizzle-graphql@0.8.5": "patches/drizzle-graphql@0.8.5.patch"
  }
}