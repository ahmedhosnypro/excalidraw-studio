# SQLite database file (libsql). Relative paths resolve from the project root.
DATABASE_URL="file:db/excalidraw-studio.db"

# Storage factory driver: "local" today; "s3" / "vercel-blob" later.
STORAGE_DRIVER="local"

# Root directory for the local filesystem storage driver.
STORAGE_LOCAL_ROOT="storage"

# Realtime collaboration mini-service (mini-services/realtime).
# The Next.js server pushes "comment added" notifications to this endpoint.
REALTIME_INTERNAL_URL="http://127.0.0.1:3004"
# Shared secret between the app server and the realtime service.
REALTIME_INTERNAL_SECRET="dev-realtime-secret"
