{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": "error",
    "typescript/no-unused-vars": "error"
  },
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "db/**",
    "storage/**",
    "scratch/**",
    "dev.log",
    "server.log"
  ]
}
